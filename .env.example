# Copy to .env.local (gitignored) and fill in the key.

# --- Model ---
# MODEL_MODE=openrouter calls a real model; MODEL_MODE=fixture replays the
# built-in NOT-gate sample without any network access.
MODEL_MODE=openrouter
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# Pick any id from src/domain/model-catalog.ts.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Any service that speaks the OpenRouter Chat Completions API.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_TIMEOUT_MS=1800000
# Global safety ceiling; most stages/models use a lower catalogued limit.
MODEL_MAX_OUTPUT_TOKENS=128000
MODEL_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_MS=8000

# --- Run policy ---
RUN_MAX_TASK_VERSIONS=2
RUN_MAX_LOGIC_VERSIONS=3
RUN_MAX_LAYOUT_VERSIONS=5
# Pre-build truth-table simulation inside layout validation. Leave on; set to
# false only to diagnose a suspected simulator/Minecraft disagreement.
RUN_LAYOUT_SIMULATION=true

# --- Minecraft ---
# MINECRAFT_MODE=live needs a running Java 1.20.4 server with the bot opped;
# MINECRAFT_MODE=mock uses an in-process, non-authoritative stand-in.
MINECRAFT_MODE=live
MC_HOST=localhost
MC_PORT=25565
MC_USER=RedstoneBot
MC_ORIGIN_X=0
MC_ORIGIN_Y=72
MC_ORIGIN_Z=0
MC_VIEWER_ENABLED=true
MC_VIEWER_PORT=3007
MC_VIEWER_PUBLIC_URL=/minecraft-viewer/

# --- Server ---
# `npm run build && npm start` serves UI + /api + viewer WebSocket on API_PORT.
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
RUNS_DIR=./runs

# Shared HTTP Basic Auth credential. REQUIRED before exposing the port publicly:
# the API spends your model credit and drives the live Minecraft server.
# Leave both blank for localhost-only use. Set them together (setting only one
# is a startup error).
WEB_AUTH_USER=
WEB_AUTH_PASS=
